# ── thesis-next - contoh environment ────────────────────────────────
# STANDALONE (institusi/fork): cukup DATABASE_URL + DB_PROVIDER + BETTER_AUTH_SECRET +
# BETTER_AUTH_URL + ADMIN_EMAILS. Sisanya (ACCOUNT_URL/NOTIFY_*/hub) khusus integrasi ke hub
# eksternal opsional (pusat akun) - kosongkan bila deploy mandiri; notifikasi tetap jalan
# in-app tanpa email hub.
#
# Lokal (SQLite) - default untuk dev, nol-setup.
DATABASE_URL="file:./dev.db"
DB_PROVIDER="sqlite"
# Produksi (MySQL / Cloud SQL db_thesis): set provider di schema.prisma -> "mysql",
# DB_PROVIDER -> "mysql", DATABASE_URL -> "mysql://USER:PASS@HOST:3306/db_thesis".
# scripts/db-provider.mjs menyamakan provider saat build. Guard db-config.ts melempar error
# bila tak konsisten.

# Better Auth
BETTER_AUTH_SECRET="ganti-dengan-string-acak-panjang"
BETTER_AUTH_URL="http://localhost:3100"
# ── SSO lintas-subdomain (opsional) ──
# Kosong = cookie host-only (default aman). Untuk berbagi sesi dengan hub akun di subdomain lain:
# AUTH_COOKIE_DOMAIN=".contoh.id"
# TRUSTED_SSO_ORIGINS="https://akun.contoh.id,https://contoh.id"

# Deep-link ke Pusat Akun (akun.contoh.id) untuk profil/tagihan/beli bimbingan.
NEXT_PUBLIC_ACCOUNT_URL="https://akun.contoh.id"

# Admin bootstrap (email dipisah koma).
ADMIN_EMAILS=""

# URL aplikasi (dipakai untuk link di email notifikasi).
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# ── Email notifikasi via HUB (opsional) ─────────────────────────────
# thesis-next TIDAK punya SMTP sendiri. Email dipicu ke hub-akun (hub) yang
# memiliki transport + template. Isi dua nilai ini untuk mengaktifkan kanal email:
#   ACCOUNT_API_URL  = base URL account-center (server-to-server), mis. http://localhost:3000
#   NOTIFY_SECRET    = shared secret yang SAMA dengan yang diset di account-center
# Kalau dikosongkan, notifikasi tetap muncul in-app (bell) tanpa email.
# ACCOUNT_API_URL="http://localhost:3000"
# NOTIFY_SECRET="ganti-dengan-string-acak-panjang-yang-sama-di-hub"

# ── Notifikasi terpusat via HUB (ADR-013) ───────────────────────────
# thesis TIDAK kirim email sendiri. Untuk notifikasi (mis. reminder sesi), thesis POST ke hub
# akun.contoh.id/api/notify (ber-secret); hub yang gate preferensi + kirim via Gmail.
# NOTIFY_URL   : base URL hub (server-to-server). Kosong -> pakai NEXT_PUBLIC_ACCOUNT_URL.
# NOTIFY_SECRET: shared secret, HARUS sama dengan NOTIFY_SECRET di hub (secret Coolify, bukan repo).
# NOTIFY_URL="https://akun.contoh.id"
# NOTIFY_SECRET="samakan-dengan-hub"

# ── Cron reminder (time-based, ADR-013 §7) ──────────────────────────
# Endpoint /api/cron/reminders dipukul scheduler tipis (Worker scheduler-hub / Coolify task).
# CRON_SECRET: verifikasi header x-cron-secret; HARUS sama dengan CRON_SECRET di scheduler.
# CRON_SECRET="string-acak-panjang"

# ── SMTP standalone (opsional) ──────────────────────────────────────
# Untuk deploy mandiri tanpa hub: kirim email (mis. kredensial impor pengguna) via SMTP kampus/vendor.
# Kalau kosong, fitur email dilewati aman (impor CSV tetap sediakan unduhan kredensial).
# SMTP_HOST="smtp.kampus.ac.id"
# SMTP_PORT="587"            # 465 = SSL, selain itu STARTTLS
# SMTP_USER="no-reply@kampus.ac.id"
# SMTP_PASSWORD="rahasia"
# MAIL_FROM="Bimbingan Skripsi <no-reply@kampus.ac.id>"

# ── SSO kampus (OIDC generik, opsional) ─────────────────────────────
# Login pakai akun kampus (Google Workspace, Microsoft Entra, Keycloak, dsb). Aktif hanya bila
# ketiga OIDC_* diset; tombol "Masuk dengan SSO" muncul bila NEXT_PUBLIC_OIDC_ENABLED=1.
# SAML/LDAP di luar cakupan (butuh add-on terpisah).
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_DISCOVERY_URL="https://sso.kampus.ac.id/.well-known/openid-configuration"
# NEXT_PUBLIC_OIDC_ENABLED="1"
# NEXT_PUBLIC_OIDC_LABEL="Masuk dengan Akun Kampus"

# ── Integrasi SIAKAD kampus (opsional) ──────────────────────────────
# Aktifkan webhook masuk (POST /api/siakad/webhook, sinkron roster mahasiswa) + API baca
# (GET /api/siakad/v1/students, tarik status skripsi). Auth via header x-siakad-secret. OFF default
# (tanpa secret -> 401). Isi secret yang sama di sisi SIAKAD.
# SIAKAD_WEBHOOK_SECRET="string-acak-panjang"

# ── Federasi admin (spoke, opsional) ────────────────────────────────
# Mengaktifkan admin API /admin/v1/* yang dipanggil hub akun.contoh.id (assign tutor, judul
# skripsi, statistik, workload) via JWT HS256 server-to-server. OFF by default: endpoint balas 503
# "belum aktif" bila kosong. Untuk mengaktifkan, isi secret yang SAMA dengan THESIS_ADMIN_API_SECRET
# di hub (secret Coolify, bukan repo). Base URL yang didaftarkan di hub = origin app ini
# (mis. https://thesis.contoh.id). Fitur bimbingan tetap jalan penuh tanpa ini.
# THESIS_ADMIN_API_SECRET="samakan-dengan-hub"

# KONFIG WARISAN dari thesis.contoh.id (Laravel) - dibawa APA ADANYA
# (stack sama, cuma bahasa/framework yang berubah). Isi nilai ASLI hanya di
# .env lokal / secret Coolify - JANGAN commit rahasia ke repo.
# ═════════════════════════════════════════════════════════════════════

# ── Database MySQL produksi (Cloud SQL db_thesis) ────────────
# Lama (Laravel .env): DB_CONNECTION=mysql DB_HOST=127.0.0.1 DB_PORT=3307
#   DB_DATABASE=db_thesis DB_USERNAME=... DB_PASSWORD=...
# Baru: satukan jadi satu DATABASE_URL (format Prisma) + DB_PROVIDER=mysql,
#   dan set datasource.provider "mysql" di schema.prisma (scripts/db-provider.mjs).
#   Nama DB ber-tanda-hubung -> URL-encode: "db_thesis" tetap boleh apa adanya di path.
# DB_PROVIDER="mysql"
# DATABASE_URL="mysql://thesis_app:PASSWORD@127.0.0.1:3307/db_thesis?sslaccept=strict"
# TLS Cloud SQL (opsional, kalau pakai Cloud SQL Proxy TLS boleh dilewati):
# DB_SSL_CA="/app/storage/certs/server-ca.pem"

# ── Google Calendar + Google Meet (auto-GMeet saat sesi disetujui) ───
# MEKANISME SAMA seperti Laravel lama (Schedule::createGoogleMeet): autentikasi sebagai akun
# sistem@contoh.id lalu Calendar API events.insert + conferenceData(hangoutsMeet) -> link Meet
# NYATA. Di Laravel token ada di storage/app/google-calendar/token.json; DI SINI cukup pindahkan
# refresh_token-nya ke env (durable, TIDAK perlu OAuth ulang). client_id/secret = kredensial OAuth
# yang sama dari oauth-credentials.json (dan sudah ada di .env Laravel: GOOGLE_CLIENT_ID/SECRET).
# Dipakai: actOnSchedule approve -> isi schedules.gmeet_link + schedules.gcal_event_id;
#   selesai -> endGoogleMeet mengunci ruang. Kosong -> fallback link manual/placeholder (alur jalan).
# GOOGLE_CLIENT_ID=""                        # = GOOGLE_CLIENT_ID lama
# GOOGLE_CLIENT_SECRET=""                    # = GOOGLE_CLIENT_SECRET lama
# GOOGLE_CALENDAR_REFRESH_TOKEN=""           # = "refresh_token" dari token.json lama (akun sistem@contoh.id)
# GOOGLE_CALENDAR_ID="c_xxxxxxxx@group.calendar.google.com"   # = GOOGLE_CALENDAR_ID lama
# Cara ambil refresh_token baru bila perlu (sekali): jalankan OAuth consent scope
#   https://www.googleapis.com/auth/calendar dengan access_type=offline & prompt=consent
#   sebagai sistem@contoh.id, salin refresh_token ke env di atas.

# ── Object storage dokumen (GCS, S3-compatible) ─────────────────────
# Lama: FILESYSTEM_DISK=gcs GOOGLE_CLOUD_PROJECT_ID=... GOOGLE_CLOUD_STORAGE_BUCKET=cdn.contoh.id
# Baru: pakai API S3-compatible GCS (SAMA seperti hub-akun untuk avatar) tapi
#   bucket PRIVAT untuk dokumen skripsi + signed URL (jangan publik seperti cdn.).
#   Kosong -> dev nulis ke public/uploads (lokal), alur tetap jalan.
# GCS_PROJECT_ID="nama-project-gcp"
# GCS_BUCKET="thesis-docs-private"          # bucket PRIVAT (bukan cdn.contoh.id yang publik)
# S3_ENDPOINT="https://storage.googleapis.com"
# S3_ACCESS_KEY_ID=""                        # HMAC key GCS
# S3_SECRET_ACCESS_KEY=""                    # HMAC secret GCS
# S3_REGION="auto"

# ── Redis (Coolify) - cache entitlement + antrian (BullMQ) ──────────
# Lama: REDIS_HOST=127.0.0.1 REDIS_PORT=6379 REDIS_PASSWORD=null
# Baru: satu REDIS_URL (service Redis di Coolify). Dipakai: cache cek entitlement
#   (default-deny, TTL pendek, ADR-008) + antrian reminder. Kosong -> tanpa cache
#   (query langsung) & reminder lewat lazy-cron, alur tetap jalan.
# REDIS_URL="redis://:PASSWORD@redis:6379"

# ── Zona waktu / lokal (paritas Laravel) ────────────────────────────
# Lama: APP_TIMEZONE=Asia/Jakarta APP_LOCALE=id. Set TZ di runtime container.
# TZ="Asia/Jakarta"
#
# CATATAN: MAIL_* (SMTP Gmail) TIDAK di sini. Email terpusat di HUB
# (hub-akun) via POST /api/notify (ADR-013). Pindahkan MAIL_HOST/PORT/
# USERNAME/PASSWORD lama ke .env HUB, bukan ke thesis-next.

# ── GCS Portal (dokumen PII, bucket PRIVAT) ──
# Kosong = dev pakai lokal (public/uploads). Diisi = upload+baca ke bucket privat via service account.
# GCS_PORTAL_BUCKET="thesis-portal-doc"
# GCP_PROJECT_ID="contoh-project-gcp"
# GOOGLE_APPLICATION_CREDENTIALS=""   # opsional; di VM pakai metadata SA

# ── Portal via cdn.contoh.id (Worker ber-token) - dokumen PII tetap privat, domain tetap cdn ──
# Kosong = dev pakai path lokal. Diisi = mint tautan cdn.contoh.id/portal/...?e=&s= (TTL) yang
# diverifikasi /api/portal + Cloudflare Worker "cdn-portal-proxy". SECRET harus SAMA seperti yang
# dipakai Worker/route (di sini keduanya di app). Buat rahasia acak panjang (mis. openssl rand -hex 32).
# PORTAL_URL_SECRET=""
# PORTAL_CDN_BASE="https://cdn.contoh.id"

# ── Sitasi: provider opsional (search tetap jalan tanpa ini; ini menambah cakupan) ──
# SEMANTIC_SCHOLAR_KEY : key gratis (api.semanticscholar.org) -> naikkan rate limit (tanpa key rawan 429).
# CORE_API_KEY         : key gratis (core.ac.uk/services/api) -> repositori kampus (skripsi/tesis/tugas akhir).
# SEMANTIC_SCHOLAR_KEY=""
# CORE_API_KEY=""


# ── Redis (cache + rate-limit; antrian ada di Cloudflare) ──
# REDIS_URL="redis://:PASSWORD@redis:6379"

